Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.6
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: AMCL Particles
      Topic:
        Value: /particle_cloud
        Reliability Policy: Best Effort
      Shape: Arrow (Flat)
      Arrow Length: 0.05
      Color: 0; 180; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Value: /plan
      Color: 0; 0; 255
      Line Width: 0.02
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic:
        Value: /local_plan
      Color: 0; 200; 255
      Line Width: 0.02
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Topic:
        Value: /local_costmap/published_footprint
      Color: 25; 255; 0
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Stop zone
      Topic:
        Value: /polygon_stop
      Color: 255; 0; 0
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Slowdown zone
      Topic:
        Value: /polygon_slowdown
      Color: 255; 170; 0
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: false
      Show Axes: false
      Show Arrows: false
      Value: false
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 110
      X: 0
      Y: 0
